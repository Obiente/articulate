{
  "name": "articulate-ui",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1 --port 4173 --strictPort",
    "build": "vite build && node scripts/prepare-sites-build.mjs",
    "preview": "vite preview",
    "test": "node --test tests/*.test.mjs",
    "test:sites": "node --test tests/sites-worker.test.mjs",
    "format": "prettier --write src tests/bridge.test.mjs vite.config.mjs",
    "format:check": "prettier --check src tests/bridge.test.mjs vite.config.mjs"
  },
  "dependencies": {
    "@mantine/core": "9.6.1",
    "@mantine/hooks": "9.6.1",
    "@mantine/notifications": "9.6.1",
    "@phosphor-icons/react": "2.1.10",
    "@tauri-apps/api": "2.11.1",
    "@vitejs/plugin-react": "5.0.4",
    "motion": "13.4.0",
    "react": "19.2.0",
    "react-dom": "19.2.0",
    "vite": "6.4.2"
  },
  "devDependencies": {
    "prettier": "3.6.2"
  }
}
