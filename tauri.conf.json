{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Articulate",
  "version": "0.3.0",
  "identifier": "org.obiente.articulate",
  "build": { "frontendDist": "ui/dist/client", "devUrl": "http://127.0.0.1:4173" },
  "app": {
    "windows": [{ "label": "main", "create": false, "title": "Articulate", "width": 1280, "height": 860, "minWidth": 850, "minHeight": 620 }],
    "security": { "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; connect-src ipc: http://ipc.localhost; object-src 'none'; frame-src 'none'; base-uri 'self'" }
  },
  "bundle": { "active": false, "icon": ["assets/brand/articulate.ico", "assets/brand/app-icon.png"] }
}
